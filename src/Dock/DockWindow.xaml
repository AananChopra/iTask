<ui:OverlayWindow x:Class="iTask.Dock.DockWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:iTask.UI"
                  Title="iTask Dock"
                  AllowsTransparency="True">
    <!-- Per-pixel transparent window: fully transparent areas pass clicks through to whatever is
         underneath, so the headroom that magnified icons grow into doesn't block anything. -->
    <Grid x:Name="Root">

        <!-- Dock body (design: translucent dark panel, hairline border, inset highlight/lowlight, soft shadow) -->
        <Border x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="{DynamicResource DockPanelBrush}" BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Grid>
                <Border x:Name="InsetTop" BorderBrush="{DynamicResource DockHighlightBrush}" BorderThickness="0,1,0,0" />
                <Border x:Name="InsetBottom" BorderBrush="{DynamicResource DockLowlightBrush}" BorderThickness="0,0,0,1" />
            </Grid>
        </Border>

        <!-- Icons: a sibling of the body (not a child) so they don't inherit its shadow and can rise above it -->
        <Canvas x:Name="Icons" HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="False" />
    </Grid>
</ui:OverlayWindow>
