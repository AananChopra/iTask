<ui:OverlayWindow x:Class="iTask.Dock.DockWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:iTask.UI"
                  Title="iTask Dock"
                  AllowsTransparency="True">
    <!-- Per-pixel transparent window: fully transparent areas pass clicks through to whatever is
         underneath, so the headroom that magnified icons grow into doesn't block anything. -->
    <Grid x:Name="Root">

        <!-- Dock body: translucent rounded panel with a faint hairline border and a soft shadow -->
        <Border x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="{DynamicResource DockPanelBrush}" BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- Icons: a sibling of the body (not a child) so they don't inherit its shadow and can rise above it -->
        <Canvas x:Name="Icons" HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="False" />
    </Grid>
</ui:OverlayWindow>
