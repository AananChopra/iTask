<UserControl x:Class="iTask.TopBar.Flyouts.BatteryFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,10,0">
            <TextBlock Text="Battery" Style="{StaticResource FlyoutHeaderText}" />
            <TextBlock x:Name="PercentText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
        <TextBlock x:Name="SourceText" Style="{StaticResource FlyoutDetailText}" />
        <TextBlock x:Name="StateText" Style="{StaticResource FlyoutDetailText}" />
        <TextBlock x:Name="SaverText" Style="{StaticResource FlyoutDetailText}" />

        <Border Style="{StaticResource FlyoutSeparator}" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Battery Settings…" Click="Settings_Click" />
    </StackPanel>
</UserControl>
