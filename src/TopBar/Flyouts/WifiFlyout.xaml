<UserControl x:Class="iTask.TopBar.Flyouts.WifiFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:top="clr-namespace:iTask.TopBar">
    <StackPanel>
        <Grid Margin="0,0,10,0">
            <TextBlock Text="Wi-Fi" Style="{StaticResource FlyoutHeaderText}" />
            <ToggleButton x:Name="RadioSwitch" Style="{StaticResource FlyoutSwitchStyle}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Click="RadioSwitch_Click" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="StatusText" Style="{StaticResource FlyoutDetailText}" />

        <StackPanel x:Name="NetworksSection">
            <Border Style="{StaticResource FlyoutSeparator}" />
            <TextBlock x:Name="NetworksHeader" Text="Networks" Style="{StaticResource FlyoutSectionText}" />
            <ItemsControl x:Name="Networks" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FlyoutItemStyle}" Click="Network_Click" ToolTip="{Binding Ssid}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <top:NetworkIcon Bars="{Binding Bars}" IsConnected="True" HasInternet="True"
                                                 Width="16" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Ssid}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lock" Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="Check" Grid.Column="3" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSecure}" Value="True">
                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="UnavailableText" Style="{StaticResource FlyoutDetailText}" Visibility="Collapsed" />
        </StackPanel>

        <Border Style="{StaticResource FlyoutSeparator}" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Other Networks…" Click="OtherNetworks_Click" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Wi-Fi Settings…" Click="Settings_Click" />
    </StackPanel>
</UserControl>
