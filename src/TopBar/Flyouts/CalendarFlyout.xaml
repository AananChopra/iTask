<UserControl x:Class="iTask.TopBar.Flyouts.CalendarFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock x:Name="TodayText" Style="{StaticResource FlyoutHeaderText}" />

        <DockPanel Margin="10,2,4,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButtonStyle}" Padding="7,3" Margin="0"
                    Click="Next_Click" ToolTip="Next month">
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" />
            </Button>
            <Button x:Name="TodayButton" DockPanel.Dock="Right" Style="{StaticResource BarButtonStyle}" Padding="7,3" Margin="0"
                    Click="Today_Click" ToolTip="Back to today">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButtonStyle}" Padding="7,3" Margin="0"
                    Click="Previous_Click" ToolTip="Previous month">
                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" />
            </Button>
            <TextBlock x:Name="MonthText" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <UniformGrid x:Name="Weekdays" Columns="7" Margin="6,0,6,2" />
        <UniformGrid x:Name="Days" Columns="7" Rows="6" Margin="6,0,6,4" />

        <Border Style="{StaticResource FlyoutSeparator}" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Date &amp; Time Settings…" Click="Settings_Click" />
    </StackPanel>
</UserControl>
