<UserControl x:Class="iTask.TopBar.Flyouts.SoundFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:top="clr-namespace:iTask.TopBar">
    <StackPanel>
        <TextBlock Text="Sound" Style="{StaticResource FlyoutHeaderText}" />

        <Grid Margin="4,2,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MuteButton" Style="{StaticResource BarButtonStyle}" Padding="6,2" Margin="0" Click="Mute_Click" ToolTip="Mute">
                <top:VolumeIcon x:Name="Speaker" />
            </Button>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FlyoutSliderStyle}" Margin="6,0"
                    ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="VolumeText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        </Grid>

        <Border Style="{StaticResource FlyoutSeparator}" />
        <TextBlock Text="Output" Style="{StaticResource FlyoutSectionText}" />
        <ItemsControl x:Name="Devices" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlyoutItemStyle}" Click="Device_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Visibility="Hidden" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource FlyoutSeparator}" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Sound Settings…" Click="Settings_Click" />
    </StackPanel>
</UserControl>
