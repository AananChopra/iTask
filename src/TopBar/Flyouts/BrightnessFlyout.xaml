<UserControl x:Class="iTask.TopBar.Flyouts.BrightnessFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Display" Style="{StaticResource FlyoutHeaderText}" />

        <Grid Margin="4,2,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="30"
                       TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource FlyoutSliderStyle}" Margin="6,0"
                    ValueChanged="BrightnessSlider_ValueChanged" />
            <TextBlock x:Name="BrightnessText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        </Grid>

        <Border Style="{StaticResource FlyoutSeparator}" />
        <Button Style="{StaticResource FlyoutItemStyle}" Content="Display Settings…" Click="Settings_Click" />
    </StackPanel>
</UserControl>
