<ui:OverlayWindow x:Class="iTask.TopBar.TopBarWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:iTask.UI"
                  xmlns:local="clr-namespace:iTask.TopBar"
                  Title="iTask Top Bar">
    <ui:OverlayWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:OverlayWindow.Resources>

    <Border Background="{DynamicResource TopBarTintBrush}">
        <!-- Content keeps its row height even when the bar is taller (e.g. filling the taskbar's strip) -->
        <Grid x:Name="BarContent" Margin="6,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: iTask menu -->
            <Button x:Name="MenuButton" Style="{StaticResource BarButtonStyle}" Click="MenuButton_Click">
                <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="14" />
            </Button>

            <!-- Left: open apps -->
            <ItemsControl x:Name="RunningApps" Grid.Column="1" Focusable="False" Margin="4,0,0,0" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="AppButton" Style="{StaticResource BarButtonStyle}" Padding="6,0" ToolTip="{Binding Name}"
                                Click="AppButton_Click" MouseRightButtonUp="AppButton_RightClick">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border x:Name="ActiveMark" Width="10" Height="2" CornerRadius="1" Margin="0,0,0,-6"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Background="{DynamicResource TextPrimaryBrush}" Visibility="Hidden" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Right: hidden tray icons (dropdown), then system status, then date & time -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <Button x:Name="TrayButton" Style="{StaticResource BarButtonStyle}" Click="TrayButton_Click" ToolTip="Show hidden icons">
                    <TextBlock x:Name="TrayChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
                <Button x:Name="NetworkButton" Style="{StaticResource BarButtonStyle}" Click="NetworkButton_Click"
                        DataContext="{Binding Network}" ToolTip="{Binding Description}">
                    <local:NetworkIcon Bars="{Binding SignalBars}" IsConnected="{Binding IsConnected}"
                                       IsWired="{Binding IsWired}" HasInternet="{Binding HasInternet}" />
                </Button>

                <Button x:Name="VolumeButton" Style="{StaticResource BarButtonStyle}" Click="VolumeButton_Click"
                        MouseWheel="VolumeButton_MouseWheel"
                        DataContext="{Binding Audio}" ToolTip="{Binding Description}"
                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                    <local:VolumeIcon Level="{Binding Volume}" IsMuted="{Binding IsMuted}" />
                </Button>

                <Button x:Name="BrightnessButton" Style="{StaticResource BarButtonStyle}" Click="BrightnessButton_Click"
                        ToolTip="{Binding Description}">
                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>

                <Button x:Name="BatteryButton" Style="{StaticResource BarButtonStyle}" Click="BatteryButton_Click"
                        DataContext="{Binding Battery}" ToolTip="{Binding Description}"
                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <local:BatteryIcon Percent="{Binding Percent}" IsCharging="{Binding IsCharging}"
                                           IsPluggedIn="{Binding IsPluggedIn}" IsSaverOn="{Binding IsSaverOn}"
                                           VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Date & time: opens the calendar -->
                <Button x:Name="ClockButton" Style="{StaticResource BarButtonStyle}" Margin="4,3,2,3" Click="ClockButton_Click"
                        DataContext="{Binding Clock}" ToolTip="{Binding LongDateText}">
                    <StackPanel x:Name="ClockPanel" Orientation="Horizontal">
                        <TextBlock x:Name="DateLabel" Text="{Binding DateText}" Margin="0,0,10,0" />
                        <TextBlock x:Name="TimeLabel" Text="{Binding TimeText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</ui:OverlayWindow>
