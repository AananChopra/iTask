<Window x:Class="iTask.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTask Settings" Width="480" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Slim overlay-style scrollbar (only shows up on short screens). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource SliderTrackBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="20,6,20,22">

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SettingsSectionText}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource FlyoutSwitchStyle}"
                                      VerticalAlignment="Center" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        <TextBlock Text="Start iTask when Windows starts" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource SettingsRowSeparator}" />
                    <DockPanel Style="{StaticResource SettingsRow}" Margin="14,8">
                        <ToggleButton x:Name="FullScreenSwitch" DockPanel.Dock="Right" Style="{StaticResource FlyoutSwitchStyle}"
                                      VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Hide the bars over full-screen apps" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Games, videos and other full-screen apps get the whole screen." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Dock -->
            <TextBlock Text="Dock" Style="{StaticResource SettingsSectionText}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Margin="14,12,14,12">
                        <TextBlock Text="Show the dock" />
                        <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="7" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeAlways" GroupName="DockMode" Style="{StaticResource SegmentStyle}"
                                             Content="Always" Checked="Changed" />
                                <RadioButton x:Name="ModeSmart" GroupName="DockMode" Style="{StaticResource SegmentStyle}"
                                             Content="Hide over full-size apps" Checked="Changed" />
                                <RadioButton x:Name="ModeAutoHide" GroupName="DockMode" Style="{StaticResource SegmentStyle}"
                                             Content="Auto-hide" Checked="Changed" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ModeHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsRowSeparator}" />
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <TextBlock x:Name="IconSizeText" DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Icon size" Width="120" VerticalAlignment="Center" />
                        <Slider x:Name="IconSizeSlider" Style="{StaticResource FlyoutSliderStyle}" VerticalAlignment="Center"
                                Minimum="32" Maximum="72" TickFrequency="4" IsSnapToTickEnabled="True"
                                ValueChanged="Changed" />
                    </DockPanel>
                    <Border Style="{StaticResource SettingsRowSeparator}" />
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <ToggleButton x:Name="MagnifySwitch" DockPanel.Dock="Right" Style="{StaticResource FlyoutSwitchStyle}"
                                      VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                        <TextBlock Text="Magnify icons on hover" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource SettingsRowSeparator}" />
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <TextBlock x:Name="MagnifyText" DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Magnification" Width="120" VerticalAlignment="Center" />
                        <Slider x:Name="MagnifySlider" Style="{StaticResource FlyoutSliderStyle}" VerticalAlignment="Center"
                                Minimum="1.2" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="Changed" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Top bar -->
            <TextBlock Text="Top bar" Style="{StaticResource SettingsSectionText}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel x:Name="TopBarRows" />
            </Border>

            <TextBlock Margin="4,14,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Changes apply right away." />
        </StackPanel>
    </ScrollViewer>
</Window>
